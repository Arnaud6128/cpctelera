# Line endings: LF in the repository for CPCtelera's own code.
/.gitattributes            text eol=lf
/.gitignore                 text eol=lf
/LICENSE                    text eol=lf
/GPL-LICENSE                text eol=lf
/README.md                  text eol=lf
setup.sh                    text eol=lf
cpctelera/cfg/**            text=auto eol=lf
cpctelera/src/**            text=auto eol=lf
cpctelera/tools/scripts/**  text=auto eol=lf
examples/**                 text=auto eol=lf

# Exceptions and binary files, never converted (keep these last: the last matching line wins)
cpctelera/tools/scripts/templates/winape/**  -text
*.png                       binary
*.jpg                       binary
*.gif                       binary
*.ico                       binary
*.exe                       binary
*.dll                       binary
*.apk                       binary
*.jar                       binary
*.zip                       binary
*.dsk                       binary
*.cdt                       binary
*.sna                       binary
*.cpr                       binary
*.rom                       binary
*.gz                       binary