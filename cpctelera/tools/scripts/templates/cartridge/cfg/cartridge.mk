############################################################################
##                        CPCTELERA ENGINE                                ##
##              Cartridge (CPR) of the CPC Plus / GX4000                  ##
##------------------------------------------------------------------------##
## This file is intended for users to build a cartridge: the files are    ##
## put in banks of 16 KB (32 at most). The bank 0 is the boot and the     ##
## program of the project (copied to the RAM at Z80CODELOC).              ##
############################################################################
##              DETAILED INSTRUCTIONS AND PARAMETERS                      ##
##------------------------------------------------------------------------##
##                                                                        ##
## Macros used are :                                                      ##
##  ADD_BANK_FILE : Add file (arg1) at the end of the bank (arg2, 1-31).  ##
##                  The files of a bank follow each other, in the order   ##
##                  of the commands. If they do not fit in the 16 KB the  ##
##                  build stops with an error message. Optional arg3:     ##
##                  LOWER = read by the lower ROM, bank must be 1-7       ##
##                  (checked); UPPER or nothing = any bank                ##
##  SET_HEADER    : C header where the bank, the offset and the size of   ##
##                  each file are written: CART_<NAME>_BANK / _OFS /      ##
##                  _SIZE / _UPPER (address in the upper ROM 0xC000-)     ##
##                                                                        ##
############################################################################

# The macro CARTRIDGE (cfg/modules/cartridge.mk) and the script cpct_mkcart are in the engine.
# The crt0 (cart/cpct_cart_crt0.s) is a file of the project: it is the boot of the bank 0.
# The files are generated by cfg/image_conversion.mk, this file only puts them in the banks.

# Where the build writes the bank, offset and size of each file (CART_<NAME>_BANK / _OFS / _SIZE / _UPPER)
$(eval $(call CARTRIDGE, SET_HEADER    , src/banks.h ))

# Files of the banks (1-31), one after the other in the order of the commands: if they do not fit in
# the 16 KB of a bank the build stops with an error. The bank 1 holds the sprite read by src/main.c
$(eval $(call CARTRIDGE, ADD_BANK_FILE , assets/sprite.bin , 1 ))